{
  "name": "conduit-test-automation-framework",
  "version": "1.0.0",
  "description": "Playwright UI and API test automation framework for the Conduit (RealWorld) demo app",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=ui --project=api",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --project=ui --project=api --grep @smoke",
    "test:cross-browser": "playwright test --project=ui-firefox --project=ui-webkit --project=ui-mobile",
    "test:all": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "yaml": "^2.9.1"
  }
}
